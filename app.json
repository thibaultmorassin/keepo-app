{
  "expo": {
    "name": "keepo-app",
    "slug": "keepo-app",
    "scheme": "keepo",
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro"
    },
    "android": {
      "package": "com.thibaultkriptown.keepoapp"
    },
    "ios": {
      "bundleIdentifier": "com.thibaultkriptown.keepoapp"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-splash-screen",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Keepo accède à vos photos pour joindre le reçu à un objet.",
          "cameraPermission": "Keepo utilise l'appareil photo pour photographier vos reçus."
        }
      ],
      "@react-native-community/datetimepicker"
    ]
  }
}
